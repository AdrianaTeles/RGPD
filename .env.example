# Copia este ficheiro para .env e preenche os valores
# NUNCA faças commit do .env — já está no .gitignore

# Chave da API do Resend (obtém em https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endereço de onde os emails são enviados
# Deve ser um domínio verificado no Resend (ex: noreply@lusotravel.pt)
# Para testes podes usar: onboarding@resend.dev (mas só envia para o teu email)
EMAIL_FROM=Lusotravel <noreply@lusotravel.pt>

# Email da agência que recebe a cópia
EMAIL_AGENCIA=geral@lusotravel.pt

# Mapa de consultores (opcional). Cada consultor usa o link do formulário com ?c=<codigo>
# e recebe cópia do email da agência; o nome fica registado no PDF.
# Formato JSON numa só linha. Aceita objeto {nome, email} ou só o email (string).
CONSULTORES_JSON={"joana":{"nome":"Joana Silva","email":"joana@lusotravel.pt"},"pedro":"pedro@lusotravel.pt"}

# ── Backoffice (/admin.html) ─────────────────────────────────────────────────
# Password partilhada da agência para entrar no backoffice.
ADMIN_PASSWORD=escolhe-uma-password-forte
# Segredo que assina o cookie de sessão. Mínimo 32 caracteres aleatórios.
# Gera com: openssl rand -base64 48
ADMIN_SESSION_SECRET=substitui-por-48-caracteres-aleatorios-gerados-com-openssl
